---
---

<section class="section" id="topology-section" hidden>
  <h2 class="topology__title text-secondary">Topologia</h2>
  <p class="topology__subtitle" id="topology-subtitle"></p>
  <div class="topology__fix" id="topology-fix" hidden>
    <span class="topology__fix-msg" id="topology-fix-msg"></span>
    <button class="btn btn--sm btn--accent" id="topology-fix-btn">[CORRIGIR]</button>
  </div>
  <div class="topology__diagram" id="topology-svg-container"></div>
</section>

<style>
  .topology__title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .topology__subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  .topology__fix {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: color-mix(in srgb, #7a3535 12%, transparent);
    border: 1px solid #7a3535;
    border-radius: var(--radius);
  }

  .topology__fix[hidden] {
    display: none;
  }

  .topology__fix-msg {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #c47777;
    flex: 1;
  }

  .topology__diagram {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow: hidden;
  }
</style>

<script>
  import { subscribe, getState, importState } from '../lib/store';
  import { buildDiagramLayout, isPublicEndpoint } from '../lib/diagram';
  import type { DiagramNode, DiagramEdge, DiagramLayout } from '../lib/diagram';

  const section = document.getElementById('topology-section')!;
  const svgContainer = document.getElementById('topology-svg-container')!;
  const subtitle = document.getElementById('topology-subtitle')!;
  const fixBar = document.getElementById('topology-fix')!;
  const fixMsg = document.getElementById('topology-fix-msg')!;
  const fixBtn = document.getElementById('topology-fix-btn')!;

  const NODE_W = 110;
  const NODE_H = 68;

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function renderNode(node: DiagramNode): string {
    const isHub = node.role === 'hub';
    const borderColor = isHub ? '#00ff9f' : '#556677';
    const borderWidth = isHub ? 2 : 1;
    const nameColor = isHub ? '#e0e0e0' : '#8899aa';
    const badgeStroke = isHub ? '#00ff9f' : '#556677';
    const badgeTextColor = isHub ? '#00ff9f' : '#556677';
    const badgeLabel = isHub ? 'HUB' : 'SPOKE';
    const endpointText = node.endpoint || '(no endpoint)';
    const displayName = node.name.length > 14 ? node.name.slice(0, 13) + '…' : node.name;

    return `<g class="diagram-node" data-role="${node.role}">
  <rect x="${node.x}" y="${node.y}" width="${NODE_W}" height="${NODE_H}" rx="4" fill="#141c27" stroke="${borderColor}" stroke-width="${borderWidth}"/>
  <text x="${node.x + NODE_W / 2}" y="${node.y + 20}" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="${nameColor}">${esc(displayName)}</text>
  <text x="${node.x + NODE_W / 2}" y="${node.y + 36}" text-anchor="middle" font-family="monospace" font-size="9" fill="#00ff9f">${esc(node.wgIp)}</text>
  <text x="${node.x + NODE_W / 2}" y="${node.y + 49}" text-anchor="middle" font-family="monospace" font-size="8" fill="#556677">${esc(endpointText)}</text>
  <rect x="${node.x + 27}" y="${node.y + 55}" width="56" height="11" rx="2" fill="#0a0e14" stroke="${badgeStroke}" stroke-width="0.8"/>
  <text x="${node.x + NODE_W / 2}" y="${node.y + 64}" text-anchor="middle" font-family="monospace" font-size="7" fill="${badgeTextColor}">${badgeLabel}</text>
</g>`;
  }

  function renderEdge(edge: DiagramEdge, isMesh: boolean): string {
    const dash = isMesh ? '' : ' stroke-dasharray="5,4"';
    const color = edge.broken ? '#7a3535' : '#1e2d3d';
    const width = edge.broken ? '1' : '1.5';
    const brokenDash = edge.broken ? ' stroke-dasharray="3,3"' : '';
    return `<line x1="${edge.x1}" y1="${edge.y1}" x2="${edge.x2}" y2="${edge.y2}" stroke="${color}" stroke-width="${width}"${dash}${brokenDash}/>`;
  }

  function renderSvg(layout: DiagramLayout, isMesh: boolean): string {
    const edges = layout.edges.map((e) => renderEdge(e, isMesh)).join('\n');
    const nodes = layout.nodes.map(renderNode).join('\n');
    return `<svg viewBox="0 0 ${layout.viewWidth} ${layout.viewHeight}" width="100%" xmlns="http://www.w3.org/2000/svg">
${edges}
${nodes}
</svg>`;
  }

  function publicEndpointPeers(peers: ReturnType<typeof getState>['peers']): typeof peers {
    return peers.filter((p) => isPublicEndpoint(p.publicEndpointIp));
  }

  fixBtn.addEventListener('click', () => {
    const { peers, network } = getState();
    const relays = publicEndpointPeers(peers);
    if (relays.length === 0) return;
    const relayIds = new Set(relays.map((p) => p.id));
    importState(
      { ...network, topology: 'hub-spoke' },
      peers.map((p) => ({ ...p, role: relayIds.has(p.id) ? 'hub' : 'spoke' })),
    );
  });

  function update(): void {
    const { peers, network } = getState();

    if (peers.length < 2) {
      section.hidden = true;
      return;
    }

    section.hidden = false;
    const isMesh = network.topology === 'mesh';

    if (isMesh) {
      subtitle.textContent = `MESH · ${peers.length} NÓS`;
    } else {
      const hubs = peers.filter((p) => p.role === 'hub').length;
      const spokes = peers.filter((p) => p.role === 'spoke').length;
      subtitle.textContent = `HUB-SPOKE · ${hubs} HUB${hubs !== 1 ? 'S' : ''} · ${spokes} SPOKE${spokes !== 1 ? 'S' : ''}`;
    }

    const layout = buildDiagramLayout(peers, network);
    const brokenCount = layout.edges.filter((e) => e.broken).length;
    const relays = isMesh ? publicEndpointPeers(peers) : [];

    if (isMesh && brokenCount > 0 && relays.length > 0) {
      const hubNames = relays.map((p) => p.name).join(', ');
      fixMsg.textContent = `${brokenCount} par${brokenCount !== 1 ? 'es' : ''} inalcançável${brokenCount !== 1 ? 'eis' : ''} — converter para hub-spoke com ${relays.length} hub${relays.length !== 1 ? 's' : ''}: ${hubNames}`;
      fixBar.hidden = false;
    } else {
      fixBar.hidden = true;
    }

    svgContainer.innerHTML = renderSvg(layout, isMesh);
  }

  subscribe(update);
  update();
</script>
